{
  "name": "visual",
  "description": "default_template_value",
  "version": "1.0.2.0",
  "repository": {
    "type": "default_template_value",
    "url": "default_template_value"
  },
  "license": "MIT",
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start",
    "package": "pbiviz package && powershell -ExecutionPolicy Bypass -File ./dist/del_move.ps1",
    "rename": "node -e \"const fs=require('fs'),path=require('path'),dir='dist';const f=fs.readdirSync(dir).find(x=>x.endsWith('.pbiviz'));if(f&&f!=='checkboxFilter.pbiviz'){fs.renameSync(path.join(dir,f),path.join(dir,'checkboxFilter.pbiviz'));console.log('Renamed to checkboxFilter.pbiviz');}\"",
    "lint": "npx eslint ."
  },
  "dependencies": {
    "@types/d3": "7.4.3",
    "d3": "7.9.0",
    "powerbi-visuals-api": "~5.3.0",
    "powerbi-visuals-utils-formattingmodel": "6.0.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-plugin-powerbi-visuals": "^1.0.0",
    "typescript": "5.5.4"
  }
}
